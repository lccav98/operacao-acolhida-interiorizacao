{
  "appId": "br.gov.sufai.acolhida",
  "appName": "Operação Acolhida - SUFAI",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "url": "http://localhost:3000/portal-migrante.html",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0b1b3a",
      "showSpinner": false
    }
  }
}
